# ===== REQUIRED ENVIRONMENT VARIABLES =====
# Copy this file to .env and fill in all required values
# NEVER commit the .env file with actual secrets to git

# Backend Port
PORT=4000

# === JWT Authentication (REQUIRED) ===
JWT_SECRET=your-very-secure-jwt-secret-min-32-chars-here

# === Admin Bootstrap (REQUIRED) ===
ADMIN_BOOTSTRAP_SECRET=your-secure-admin-bootstrap-secret-here

# === OTP Configuration (Optional) ===
OTP_EXPOSE_DEV_CODE=false

# SMS OTP Provider (twilio or custom)
SMS_OTP_ENABLED=false
SMS_OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_SMS_FROM=+1234567890

# Email OTP Provider (resend)
EMAIL_OTP_ENABLED=false
EMAIL_OTP_PROVIDER=resend
EMAIL_OTP_FROM=noreply@civicpulse.local
RESEND_API_KEY=your-resend-api-key

# === AI Services (Optional) ===
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_CATEGORY_PROVIDER=auto

# === MongoDB ===
# Required for current backend storage implementation.
MONGODB_URI=mongodb://localhost:27017/pune-pulse

# === Web Origins (CORS) ===
WEB_ORIGIN=http://localhost:5173,http://localhost:8080

# === Docker Configuration ===
FRONTEND_PORT=8080
BACKEND_PORT=4000
MONGO_PORT=27017

# === Environment ===
NODE_ENV=development
